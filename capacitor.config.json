{
  "appId": "com.hunterseriph.app",
  "appName": "Hunter Seriph",
  "webDir": "www",
  "backgroundColor": "#070405",
  "android": {
    "backgroundColor": "#070405"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "server": {
    "hostname": "hunterseriph.app",
    "androidScheme": "https",
    "allowNavigation": [
      "*.twitch.tv",
      "twitch.tv",
      "*.twitchcdn.net",
      "*.ttvnw.net",
      "*.twitch.map.fastly.net",
      "*.google.com",
      "*.gstatic.com",
      "*.hcaptcha.com",
      "*.arkoselabs.com",
      "*.funcaptcha.com",
      "*.recaptcha.net"
    ]
  }
}